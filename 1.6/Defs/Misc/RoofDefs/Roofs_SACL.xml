<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Fallback glass roof, only used when no third party skylight mod is installed.
       ModCompat discovers it (and any equivalent from another mod) through the
       TransparentRoofExtension marker, so the thermal module never hard-codes a def name. -->
  <RoofDef>
    <defName>SACL_GlassRoof</defName>
    <label>glass roof</label>
    <isThickRoof>false</isThickRoof>
    <isNatural>false</isNatural>
    <canCollapse>true</canCollapse>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <soundPunchThrough>PunchThroughRoofMetal</soundPunchThrough>
    <modExtensions>
      <li Class="SmartAgriculture.TransparentRoofExtension" />
    </modExtensions>
  </RoofDef>

</Defs>
